      "Menu_Item": [
        {
          "id": 11,
          "Item_Name": "Traditional Irish Beef & Guinness Stew",
          "Price": 16.5,
          "Description": "Tender slow-cooked beef, root vegetables, and potatoes in a rich Guinness gravy, served with creamy mashed potato."
        },
        {
          "id": 12,
          "Item_Name": "Grilled Atlantic Salmon",
          "Price": 17.5,
          "Description": "Fresh salmon fillet grilled to perfection, served with buttery potatoes, sautéed seasonal vegetables, and lemon dill sauce."
        },
        {
          "id": 13,
          "Item_Name": "Classic Chicken Caesar Salad",
          "Price": 14,
          "Description": "Grilled chicken breast, crisp romaine lettuce, Parmesan shavings, garlic croutons, and creamy Caesar dressing."
        },
        {
          "id": 14,
          "Item_Name": "Irish Angus Beef Burger",
          "Price": 15,
          "Description": "Char-grilled Irish beef patty, cheddar cheese, crispy bacon, lettuce, tomato, red onion, and house sauce in a toasted brioche bun. Served with fries."
        }
