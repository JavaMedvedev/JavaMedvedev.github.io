          "Content": [
            {
              "id": 45,
              "Title": "Our Ethos",
              "Text": "We believe in holistic wellbeing and genuine hospitality. Our approach blends attentive service with a tranquil environment, so that every guest can relax, rejuvenate and rediscover balance.\n\nWe champion natural materials and soothing design throughout our spa spaces, ensuring that each treatment fosters harmony between mind, body and spirit. Our ethos is rooted in respect for both you and the environment, guiding every aspect of our service.\n\n\n",
              "Media": null,
              "Photoslider": null
            }
          ]
